{
  "name": "intuneget",
  "version": "0.8.5",
  "private": true,
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/maybe-translate.mjs && next build --webpack",
    "build:ci": "next build --webpack",
    "translate": "npx -y gt@^2 translate --ignore-errors",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "curated:validate": "node scripts/curated-catalog.mjs validate",
    "curated:discover": "node scripts/curated-catalog.mjs discover",
    "test:coverage": "vitest run --coverage",
    "perf:bundles": "node scripts/measure-bundles.mjs --check"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/msal-browser": "^5.26.0",
    "@azure/msal-node": "^7.1.1",
    "@azure/msal-react": "^5.7.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.6.0",
    "gt-next": "^11.4.16",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
